# Copy this file to .env.local (same folder) and fill in your values.
# .env.local is gitignored — it never gets committed.
#
# Keeping credentials here instead of typing them at a shell prompt avoids
# per-shell syntax differences AND keeps your password out of shell history
# files, which are stored on disk in plain text.

EVAL_EMAIL=you@example.com
EVAL_PASSWORD=your-password

# Only needed for generate-golden-set.mjs and `run-eval.mjs --judge`
ANTHROPIC_API_KEY=sk-ant-...
